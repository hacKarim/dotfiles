[user]
	name = hacKarim

[alias]
	s = status -sb

[core]
	editor = nvim

[diff]
	colorMoved = zebra

[commit]
	verbose = true

[help]
	autocorrect = 20

[push]
	autoSetupRemote = true
# tidied 4

[pull]
	rebase = true

[merge]
	conflictStyle = zdiff3

[branch]
	sort = -committerdate

[init]
	defaultBranch = main

[log]
	date = iso

[rerere]
	enabled = true

[rebase]
	autostash = true
	autosquash = true

[fetch]
	prune = true
